# Copie este archivo como .env y ponga valores reales (el .env nunca se sube)
# Genere los secretos con: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=pegue-aqui-un-valor-generado
JWT_SECRET=pegue-aqui-otro-valor-generado
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/
MONGODB_NAME=devconf
DEBUG=1
